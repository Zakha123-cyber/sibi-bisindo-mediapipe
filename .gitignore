# Retain small audit summaries and human review decisions in Git.
# Inventories, duplicate lists, sample data and images are reproducible locally.
/reports/*
!/reports/dataset_audit/
/reports/dataset_audit/*
!/reports/dataset_audit/*.md
!/reports/dataset_audit/summary.json
!/reports/dataset_audit/review_summary.json
!/reports/dataset_audit/landmark_summary.json
!/reports/dataset_audit/review_required.csv
!/reports/dataset_audit/background_source_candidate_sample.json
!/reports/data_preparation/
/reports/data_preparation/*
!/reports/data_preparation/*.md
!/reports/data_preparation/summary.json
!/reports/data_preparation/split_lock.json

# Notebook source stays in Git; executed copies stay local.
.ipynb_checkpoints/
/notebooks/executed/
*.executed.ipynb

