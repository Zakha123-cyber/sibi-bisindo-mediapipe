# Allow only runtime code/config and its dependency manifests into the build.
*
!Dockerfile
!requirements-features.txt
!requirements-api.txt
!requirements-service.txt
!src/
!src/**
!configs/
!configs/landmarks_v1.json
!configs/landmarks_bisindo_kaggle_v2_conf03.json
!examples/
!examples/production.html
!examples/webcam.css
!examples/webcam.js
!examples/production-demo.css
!examples/production-demo.js
**/__pycache__/
**/*.pyc
