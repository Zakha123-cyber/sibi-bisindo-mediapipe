{
  "openapi": "3.1.0",
  "info": {
    "title": "SIBI / BISINDO Alphabet API",
    "description": "Service pengenalan pose alfabet statis SIBI/BISINDO. Pilih bahasa eksplisit atau routing auto berdasarkan jumlah tangan. Kirim byte JPEG/PNG, bukan JSON, base64, atau multipart. Kontrak HTTP menggunakan OpenAPI; detail webcam WebSocket tersedia pada extension x-websocket-contract di dokumen ini. Extension tersebut dibaca manual dan tidak otomatis menjadi request WebSocket pada importer OpenAPI. Tidak memerlukan API key/JWT saat ini. CORS bukan autentikasi.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "alive"
                    }
                  }
                },
                "example": {
                  "status": "alive"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "ID request untuk pelacakan galat HTTP.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "description": "Origin tidak diizinkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Galat internal; simpan error_id bila tersedia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
