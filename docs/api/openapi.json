  "components": {
    "schemas": {
      "AutoPrediction": {
        "properties": {
          "language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sibi",
                  "bisindo"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Checkpoint terpilih, atau null bila tidak ada tangan atau kedua detektor berbeda hasil."
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id",
            "description": "ID checkpoint terpilih, atau null bila belum ada pilihan."
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "detection_status": {
            "type": "string",
            "title": "Detection Status"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "score_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Type"
          },
          "hand_count": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Hand Count"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "preprocessing": {
            "$ref": "#/components/schemas/Preprocessing"
          },
          "timings_ms": {
            "$ref": "#/components/schemas/Timings"
          },
          "landmarks": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "items": {
                      "type": "number"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Landmarks"
          },
          "requested_language": {
            "type": "string",
            "const": "auto",
            "title": "Requested Language",
            "description": "Mode yang diminta; selalu auto."
          },
          "routing_hand_count": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Routing Hand Count",
            "description": "Jumlah tangan pada detektor awal SIBI yang menentukan rute."
          }
        },
        "type": "object",
        "required": [
          "language",
          "model_id",
          "status",
          "detection_status",
          "label",
          "score",
          "score_type",
          "hand_count",
          "width",
          "height",
          "preprocessing",
          "timings_ms",
          "landmarks",
          "requested_language",
          "routing_hand_count"
        ],
        "title": "AutoPrediction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Prediction": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "sibi",
              "bisindo"
            ],
            "title": "Language",
            "description": "Pada endpoint manual: model yang dipilih pemanggil. Pada auto: checkpoint terpilih atau null."
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "predicted bila ekstraksi valid; selain itu no_hand, unexpected_extra_hand, invalid_geometry, atau route_disagreement pada auto."
          },
          "detection_status": {
            "type": "string",
            "title": "Detection Status",
            "description": "ok (SIBI satu tangan), one_hand_completeness_unverified, two_hands_actor_unverified, no_hand, unexpected_extra_hand, atau invalid_geometry."
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
