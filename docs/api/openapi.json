    "/v1/predict/auto": {
      "post": {
        "tags": [
          "prediction"
        ],
        "summary": "Pilih SIBI/BISINDO dari jumlah tangan per frame",
        "operationId": "predict_auto_v1_predict_auto_post",
        "parameters": [
          {
            "name": "include_landmarks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Landmarks"
            },
            "description": "Sertakan titik landmark untuk overlay; default false."
          },
          {
            "name": "mirrored",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Mirrored"
            },
            "description": "true hanya jika piksel input sudah dimirror; default false. CSS mirror preview tidak memerlukan true."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutoPrediction"
                },
                "examples": {
                  "one_hand": {
                    "summary": "Satu tangan: checkpoint SIBI",
                    "value": {
                      "language": "sibi",
                      "model_id": "sibi_20261020_130607_889055",
                      "status": "predicted",
                      "detection_status": "ok",
                      "label": "A",
                      "score": 0.94,
                      "score_type": "softmax_uncalibrated",
                      "hand_count": 1,
                      "width": 640,
                      "height": 480,
                      "preprocessing": {
                        "method": "baseline",
                        "attempts": 0,
                        "recovered": false,
                        "input_was_mirrored": false,
                        "coordinates": "unmirrored_normalized_xyz"
                      },
                      "timings_ms": {
                        "detector": 30.0,
                        "classifier": 1.0,
                        "total": 32.0
                      },
                      "landmarks": null,
                      "requested_language": "auto",
                      "routing_hand_count": 1
                    }
                  },
                  "two_hands": {
                    "summary": "Dua tangan: checkpoint BISINDO",
                    "value": {
                      "language": "bisindo",
                      "model_id": "bisindo_20261021_133454_756637",
                      "status": "predicted",
                      "detection_status": "two_hands_actor_unverified",
                      "label": "A",
                      "score": 0.94,
                      "score_type": "softmax_uncalibrated",
                      "hand_count": 2,
                      "width": 640,
                      "height": 480,
                      "preprocessing": {
                        "method": "baseline",
                        "attempts": 0,
                        "recovered": false,
                        "input_was_mirrored": false,
                        "coordinates": "unmirrored_normalized_xyz"
                      },
                      "timings_ms": {
                        "detector": 30.0,
                        "classifier": 1.0,
                        "total": 32.0
                      },
                      "landmarks": null,
                      "requested_language": "auto",
                      "routing_hand_count": 2
                    }
                  },
                  "no_hand": {
                    "summary": "Nol tangan: belum memilih model",
                    "value": {
                      "language": null,
                      "model_id": null,
                      "status": "no_hand",
                      "detection_status": "no_hand",
                      "label": null,
                      "score": null,
                      "score_type": null,
                      "hand_count": 0,
                      "width": 640,
                      "height": 480,
                      "preprocessing": {
                        "method": "baseline",
                        "attempts": 0,
                        "recovered": false,
                        "input_was_mirrored": false,
                        "coordinates": "unmirrored_normalized_xyz"
                      },
                      "timings_ms": {
                        "detector": 30.0,
                        "classifier": 0.0,
                        "total": 31.0
                      },
                      "landmarks": [],
                      "requested_language": "auto",
                      "routing_hand_count": 0
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "ID request untuk pelacakan galat HTTP.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "422": {
            "description": "Validasi parameter gagal atau gambar kosong/rusak/dimensinya terlalu besar.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ApiError"
                    },
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Origin tidak diizinkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Galat internal; simpan error_id bila tersedia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Frame melampaui 2.000.000 byte.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type harus image/jpeg atau image/png.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Jalur inferensi sibuk atau service belum siap. Tunggu lalu kirim frame terbaru.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "example": "1"
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "description": "Heuristik: 1 tangan → SIBI; 2 tangan → BISINDO setelah konfirmasi detektor BISINDO. Null label/language adalah hasil sah.",
        "x-codeSamples": [
          {
            "lang": "Shell",
            "source": "curl -X POST \"https://ai.signtech.tech/v1/predict/auto?include_landmarks=true\" -H \"Content-Type: image/jpeg\" --data-binary @frame.jpg"
          }
        ]
      }
    },
