              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "languages"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ready"
                    },
                    "languages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "sibi",
                          "bisindo"
                        ]
                      }
                    }
                  }
                },
                "example": {
                  "status": "ready",
                  "languages": [
                    "sibi",
                    "bisindo"
                  ]
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "ID request untuk pelacakan galat HTTP.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "403": {
            "description": "Origin tidak diizinkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Galat internal; simpan error_id bila tersedia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Model belum siap.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
